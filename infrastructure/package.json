{
  "name": "irl-infrastructure",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy --force",
    "test": "find lambda/api -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:functional": "find test/functional -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:all": "find lambda/api test/functional -name '*.test.mjs' -print0 | xargs -0 node --test"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "aws-cdk": "^2.170.0",
    "aws-sdk-client-mock": "^4.1.0",
    "typescript": "^5.0.0"
  }
}
